# ─── Core ─────────────────────────────────────────────────────────────────────
# Set to 'production' for secure session cookies (required when app is served over HTTPS).
# Set to 'development' only for local dev without HTTPS.
NODE_ENV=production
PORT=3001
APP_NAME=Oblihub

# Session / DB
SESSION_SECRET=change-this-in-production

# Postgres password — used by compose to build the connection string for the server.
# Keep this in sync if you change it (the running stack will need a DB rebuild otherwise).
DB_PASSWORD=changeme

# Connection string. Only honored when running the server OUTSIDE compose (local dev with
# `npm run dev`). In docker-compose deployment, the compose file ignores this and builds the
# URL itself from DB_PASSWORD pointing at the `postgres` service. Leave commented unless
# you're running Oblihub server natively against a local Postgres.
# DATABASE_URL=postgres://oblihub:changeme@localhost:5432/oblihub

# Origin used for CORS — must match the URL from which the client is served.
# With self-signed HTTPS, typically https://localhost:3101 (or your FQDN).
CLIENT_ORIGIN=https://localhost:3101

# Default admin created on first boot if users table is empty.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Docker socket path inside the server container.
DOCKER_SOCKET=/var/run/docker.sock

# ─── Filesystem ───────────────────────────────────────────────────────────────
# Host directory that mounts to `/data/stacks` inside the server container. All managed
# compose files land here — inspectable / editable over ssh. Default `/data/stacks` matches
# the container path so `docker inspect` labels (which record host paths) stay consistent.
# Change if you prefer another location.
# Named volumes of managed stacks (created since volume placement was added) are stored in
# `<STACKS_HOST_DIR>/.volumes/<stack>/<volume>/` — include that folder in your backups. To change
# STACKS_HOST_DIR later: "Down" those stacks, move `.volumes` along with the rest, then deploy —
# Oblihub re-points the volumes. It refuses to deploy a stack whose data folder it can no longer
# find rather than start it on empty volumes.
# STACKS_HOST_DIR=/data/stacks

# ─── Feature flags (true / 1 / yes) ───────────────────────────────────────────
# Container web console (xterm via docker exec). Disabled by default.
ALLOW_CONSOLE=false
# Managed Docker Compose stacks (create / update / deploy compose from the UI).
ALLOW_STACK=false
# Integrated nginx reverse proxy (proxy hosts, Let's Encrypt, streams, redirects).
ALLOW_NGINX=false

# ─── Intervals ────────────────────────────────────────────────────────────────
# DISCOVERY_INTERVAL=30000       # ms — how often DiscoveryWorker scans Docker
# DEFAULT_CHECK_INTERVAL=60      # seconds — default image update check interval per stack

# ─── Docker Hub auth (optional, recommended) ──────────────────────────────────
# Avoids anonymous rate limits (100 pulls/6h per IP). Authenticated free accounts get
# 200/6h; Pro/Team are effectively unlimited. Applies to both update digest checks AND
# image pulls performed by Oblihub itself.
#
# Create an access token at https://hub.docker.com/settings/security (Read-only scope is
# enough) and use it as the token below — DO NOT put your account password here.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# ─── Multi-engine resources (optional) ────────────────────────────────────────
# Leave these unset (or empty) to keep the built-in defaults.
#
# Image of the host-metrics agent (`oblihub-host-agent`) and of the short-lived one-shot helpers
# (`oblihub-oneshot-*`: GPU power limits, MPS probe) that Oblihub may run on an engine.
# Default: ubuntu:24.04. Must be glibc-based — Alpine / busybox won't work, because nvidia-smi is
# injected from the host and is glibc-linked. Must be an image you TRUST: the power-limit one-shots
# run it with CAP_SYS_ADMIN (`nvidia-smi -pl`). On air-gapped hosts point it at a local mirror (or
# pre-pull ubuntu:24.04 on every engine).
# OBLIHUB_AGENT_IMAGE=ubuntu:24.04
#
# Seconds between host agent samples, 2-30. Default: 3.
# OBLIHUB_AGENT_INTERVAL=3
#
# Oblihub's own compose project name. Only needed when Oblihub cannot inspect its own container:
# Oblihub uses it to recognise its own stack, and then refuses resource limits and compose commands
# on that project (it redeploys itself through its helper container instead).
# OBLIHUB_COMPOSE_PROJECT=oblihub

# ─── Obligate SSO (optional) ──────────────────────────────────────────────────
# The Obligate URL, API key and "Enable SSO" live in Settings > Obligate SSO. "Enable SSO" off
# turns every SSO route off (sign-in, and Obligate's calls to Oblihub are refused with 401).
#
# Public URL of this Oblihub, as users reach it (e.g. https://oblihub.example.com). RECOMMENDED
# whenever Obligate SSO is used. The OAuth redirect_uri is only ever built on a trusted origin —
# the Host / X-Forwarded-* headers alone are never trusted:
#   - APP_URL, or CLIENT_ORIGIN when it is not a localhost URL: only these (and the base URL
#     registered in Obligate is then ignored);
#   - neither set (CLIENT_ORIGIN left at its http://localhost default): Oblihub's base URL
#     registered in Obligate, only when exactly ONE Oblihub app is registered there. SSO then
#     only works on that exact host (a LAN IP or a second DNS name is sent back to it), and a
#     registration that is not this instance's would be trusted: set APP_URL.
# APP_URL=
#
# The browser-facing client_id is always the public id sha256(API key): Obligate refuses the raw key.
#
# Secret Obligate must present (Bearer) when it calls Oblihub (user sync, app info, dashboard
# stats). Empty = the API key is expected. Set it ONLY once Obligate sends a separate secret, or
# its calls are refused (401). At least 16 characters. Wins over the Settings value.
# OBLIGATE_INBOUND_SECRET=

# ─── Docker Compose deployment ────────────────────────────────────────────────
OBLIHUB_VERSION=latest

# Client listen ports (host → container)
LISTEN_PORT=3100        # HTTP  → container :80
LISTEN_PORT_HTTPS=3101  # HTTPS → container :443 (self-signed by default)

# Integrated proxy listen ports (only if ALLOW_NGINX=true)
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# ─── Tailscale (optional) ─────────────────────────────────────────────────────
# Opt-in: start with `docker compose --profile tailscale up -d` to enable the
# sidecar. When the profile is omitted, Oblihub runs exactly as before and the
# Tailscale UI section gracefully shows "Disabled".
#
# Get an auth key from https://login.tailscale.com/admin/settings/keys
# (reusable, ephemeral, or pre-approved — your choice).
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=oblihub
# Extra flags appended to `tailscale up` inside the sidecar (e.g. --ssh, --advertise-tags=tag:server).
TAILSCALE_EXTRA_ARGS=

# Make the integrated proxy join the Tailscale netns so it can resolve MagicDNS
# names and reach Tailnet subnet routes (e.g. remote Docker bridge IPs) directly.
# Set to `service:tailscale` to enable; keep `bridge` (default) for standard Docker networking.
# Only meaningful when the tailscale profile is active.
PROXY_NETWORK_MODE=bridge
# When PROXY_NETWORK_MODE=service:tailscale, also set this to true so nginx's resolver
# directive includes 100.100.100.100 (Tailscale's MagicDNS) alongside Docker's 127.0.0.11.
PROXY_TAILSCALE_DNS=false
